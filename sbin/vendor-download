#!/usr/bin/env ruby

require 'bundler/inline'

gemfile do
  source 'https://rubygems.org'
  gem 'json'
  gem "faraday", "~> 2.14"
  gem "typhoeus", "~> 1.6"
  gem "mail", "~> 2.9"
  gem "pry"
end
require 'fileutils'
require 'uri'
require 'pathname'
require 'pry'
require 'json'

class Main
  attr_accessor :progname, :project_dir, :dst_dir

  def initialize
    @progname = Pathname.new($0).realpath.basename
    @project_dir = Pathname.new(__FILE__).parent.parent.realpath
    @dst_dir = project_dir / "vendor"
  end

  def download(url)
    url = URI.parse(url)
    src_path = Pathname.new(url.host + url.path)
    name, version, _PDF = $1, $2, $3 if %r{/([^/]+)/([^/]+)(/PDF)?$}.match(src_path.to_s)
    response = Faraday.get(url)
    raise "#{url} #{response.status}" if ! response.success?
    content_type = response.headers["content-type"]
    content_disposition = Mail::ContentDispositionField.new(response.headers["content-disposition"])
    filename = Pathname.new(content_disposition.filename || "")
    dst_path = dst_dir / src_path
    dst_links = []
    if (
      src_path.extname == "" &&
      _PDF &&
      filename.extname == ".pdf" &&
      content_type == 'application/pdf'
    )
      dst_path = dst_dir / src_path / filename
      dst_links << dst_dir / src_path / "#{name}-#{version}-#{filename}"
      dst_links << dst_dir / src_path / "#{name}-#{version}#{filename.extname}"
    end

    result = {
      url: url,
      response: {
        status: response.status,
        headers: response.headers.to_h,
        filename: filename.to_s,
      },
      src_path: src_path.to_s,
      dst_path: dst_path.relative_path_from(dst_dir).to_s,
      dst_links: dst_links.map{|p| p.relative_path_from(dst_dir).to_s},
    }
    puts(JSON.pretty_generate(result))

    dst_path.parent.mkpath
    dst_path.unlink if dst_path.exist?
    dst_path.write(response.body)

    dst_links.each do | dst_link |
      dst_target = dst_path.relative_path_from(dst_link.parent)
      dst_link.parent.mkpath
      dst_link.unlink if dst_link.exist?
      File.symlink(dst_target.to_s, dst_link.to_s)
    end
    result
  end

  def scrape_omg_spec url
    rx = %r{href="(https://www\.omg\.org/spec/[^"]+(\.xmi|\.ocl|\.zip|\.xsd|\.cmof|\.emof|/PDF))"}
    urls = []
    Faraday.get(url).body.scan(rx) do | m |
      urls << m[0]
    end
    urls.sort!.uniq!
  end

  def call argv
    omg_spec_urls = %w[
      https://www.omg.org/spec/UML/2.5.1
      https://www.omg.org/spec/UML/2.4.1
      https://www.omg.org/spec/MOF/2.5.1
      https://www.omg.org/spec/MOF/2.4.2
      https://www.omg.org/spec/MOF/2.0
      https://www.omg.org/spec/XMI/2.5.1
      https://www.omg.org/spec/XMI/2.4.2
      https://www.omg.org/spec/XMI/2.1.1
      https://www.omg.org/spec/XMI/2.0
      https://www.omg.org/spec/OCL/2.4
      https://www.omg.org/spec/OCL/2.3.1
      https://www.omg.org/spec/OCL/2.2
      https://www.omg.org/spec/OCL/2.0
      https://www.omg.org/spec/IDL/4.2
      https://www.omg.org/spec/IDL/4.1
      https://www.omg.org/spec/IDL/4.0
      https://www.omg.org/spec/IDL/3.5
    ]
    urls = omg_spec_urls.flat_map do | spec_url |
      scrape_omg_spec(spec_url)
    end.sort!.uniq!

    result = urls.map do |url|
      download(url)
    end

    json = JSON.pretty_generate(result)
    puts(json)
    File.write("#{dst_dir}/#{progname}.json", json)
  end
end
Main.new.call(ARGV)

